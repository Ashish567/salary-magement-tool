generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Employee {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  fullName String
  email     String   @unique
  country   String
  jobTitle  String
  salary    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([country])
  @@index([jobTitle])
  @@index([createdAt])
  @@index([salary])
  @@index([country, jobTitle])
}
